# Copy to .env.e2e locally. Do not commit real credentials or production test data.
E2E_BASE_URL=http://127.0.0.1:3000
E2E_USERNAME=
E2E_PASSWORD=
E2E_TEST_CUSTOMER=
E2E_TEST_DESCRIPTION=
E2E_EXPECTED_RATE=
E2E_TEST_JOB_NO=

# Required before any test that saves a draft or invoice can run.
E2E_ALLOW_MUTATIONS=false
